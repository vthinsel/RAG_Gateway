# Required: generate a long random secret and never commit populated .env.
GATEWAY_API_KEY=replace-with-a-long-random-secret
# Optional JSON object: SHA-256 bearer-key hash -> authorized tenant IDs.
API_KEY_REGISTRY={}

# Atlas SRV URI. Restrict database user to read/write on this database.
MONGODB_URI=
# MongoDB API model service endpoint (hostname only).
MONGODB_API_MODEL_ENDPOINT=ai.mongodb.com
MONGODB_DATABASE=rag_gateway
MONGODB_COLLECTION=chunks
ATLAS_VECTOR_INDEX=rag_chunks_vector

# Voyage AI. Verify the selected model's current output dimensions.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=64

# Native Windows uses localhost. Docker Compose overrides this for the container.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
PUBLIC_MODEL_NAME=rag-local

DEFAULT_TENANT_ID=default
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
RETRIEVAL_NUM_CANDIDATES=100
MAX_DOCUMENT_CHARS=1000000
MAX_QUERY_CHARS=8000
UPSTREAM_TIMEOUT_SECONDS=180

# Optional local folder loader. Web jobs are restricted to these directories.
DOCUMENT_LOADER_ENABLED=false
DOCUMENT_LOADER_ROOTS=[]
DOCUMENT_LOADER_MAX_ACTIVE_JOBS=2
DOCUMENT_PARSER_MODEL=glm-ocr:latest
DOCUMENT_PARSER_TIMEOUT_SECONDS=300

GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8000
